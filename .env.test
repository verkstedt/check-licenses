      "https://www.iana.org/help/licensing-terms"
    ],
    "licenses": "CC0-1.0"
  },
  "@turf/jsts@^2.7.0": {
    "//": "Uses “(EDL-1.0 OR EPL-1.0)”, but “EDL-1.0” is not SPDX id",
