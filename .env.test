# By convention you’d set *_GLOBAL vars on the organisation level in
# your CI/CD and others would be repository–specific.

ALLOW_LICENSES_GLOBAL="
# https://spdx.org/licenses/

0BSD
Apache-2.0
Artistic-2.0
BSD-2-Clause
BSD-3-Clause
BSD-4-Clause
BSD-4-Clause-UC
BSL-1.0
Beerware
BlueOak-1.0.0
CC-BY-3.0
CC-BY-4.0
CC0-1.0
EPL-1.0
EPL-2.0
Fair
ISC
JSON
Libpng
MIT
MIT-0
MIT-advertising
MS-PL
Python-2.0
Unicode-DFS-2016
Unlicense
WTFPL
X11
Zlib
"

ALLOW_LICENSES=""

ALLOW_LICENSES_DEV_GLOBAL=""
ALLOW_LICENSES_DEV=""

EXCLUDE_PACKAGES_GLOBAL="
# Us
@verkstedt/*

# Clients
@redteclab/*

# We have a license for these
@mui/x-*

# LGPL-3.0-or-later, used in Next.js at build time
@img/sharp-libvips-*
"

EXCLUDE_PACKAGES=""

EXCLUDE_PACKAGES_DEV_GLOBAL="
# Licensed under MPL-2.0
axe-core
"

EXCLUDE_PACKAGES_DEV=""

CLARIFICATIONS='
{
  "language-subtag-registry@<0.3.22": {
    "//": [
      "Older versions of the package were marked as ODC-By-1.0 and",
      "later switched to CC0-1.0 but source of the data always was",
      "iana, which allows to use the data freely.",
      "https://www.iana.org/help/licensing-terms"
    ],
    "licenses": "CC0-1.0"
  },
  "@turf/jsts@^2.7.0": {
    "//": "package.json specifies “(EDL-1.0 OR EPL-1.0)”, but “EDL-1.0” is not SPDX id",
    "licenses": "EPL-1.0"
  },
  "jsts@^2.7.0": {
